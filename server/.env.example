PORT=4000
# Local Docker MongoDB (single-node replica set, see ../docker-compose.yml). Atlas: mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/crm?replicaSet=rs0&directConnection=true
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
# The account every request is scoped to (no auth in this demo); the seed creates it
DEFAULT_ACCOUNT_ID=6650a0000000000000000001
