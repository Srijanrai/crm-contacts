{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "vitest",
    "node"
  ],
  "rules": {
    "typescript/no-explicit-any": "error",
    "no-console": "off",
    "vitest/valid-expect": [
      "warn",
      {
        "maxArgs": 2
      }
    ]
  },
  "ignorePatterns": [
    "dist",
    ".cache"
  ]
}
